<?xml version="1.0" encoding="utf-8"?>
<LinearLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/toolbar_bg"
        app:navigationIcon="@drawable/ic_hamburger"
        app:navigationIconTint="@color/text">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ตั้งค่าระบบ (VPN Settings)"
            android:textColor="@color/text"
            android:textSize="16sp"
            android:textStyle="bold" />
    </com.google.android.material.appbar.MaterialToolbar>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Custom Payload -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Custom Payload"
                android:textColor="@color/text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/payloadInput"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/card"
                android:gravity="top|start"
                android:hint="CONNECT [host_port] [protocol]"
                android:padding="12dp"
                android:textColor="@color/text"
                android:textColorHint="@color/muted"
                android:textSize="13sp" />

            <!-- SNI / Bug Host -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="SNI / Bug Host"
                android:textColor="@color/text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/sniInput"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/card"
                android:hint="m.facebook.com"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:singleLine="true"
                android:textColor="@color/text"
                android:textColorHint="@color/muted"
                android:textSize="13sp" />

            <!-- Custom DNS -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Custom DNS"
                android:textColor="@color/text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/dns1Input"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:background="@drawable/card"
                    android:hint="8.8.8.8"
                    android:gravity="center"
                    android:singleLine="true"
                    android:textColor="@color/text"
                    android:textColorHint="@color/muted"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/dns2Input"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:background="@drawable/card"
                    android:hint="8.8.4.4"
                    android:gravity="center"
                    android:singleLine="true"
                    android:textColor="@color/text"
                    android:textColorHint="@color/muted"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- ปุ่มบันทึกการตั้งค่า -->
            <Button
                android:id="@+id/btnSave"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="30dp"
                android:backgroundTint="#1E293B"
                android:text="บันทึกการตั้งค่า"
                android:textColor="@color/text" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
