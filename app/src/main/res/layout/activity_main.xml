<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <!-- เพิ่ม Toolbar ด้านบนสุด -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/bg">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="H T T P  C O N N E C T  V P N"
            android:textColor="@color/muted"
            android:textSize="12sp"
            android:letterSpacing=".18" />
    </androidx.appcompat.widget.Toolbar>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="AetherLink"
                android:textColor="@color/text"
                android:textSize="32sp"
                android:textStyle="bold" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="10dp">

                <View
                    android:layout_width="190dp"
                    android:layout_height="190dp"
                    android:layout_gravity="center"
                    android:background="@drawable/ring_outer" />

                <View
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    android:layout_gravity="center"
                    android:background="@drawable/ring_inner" />

                <LinearLayout
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:background="@drawable/power_circle">

                    <TextView
                        android:id="@+id/powerIcon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="◯"
                        android:textColor="@color/text"
                        android:textSize="36sp" />

                    <Button
                        android:id="@+id/connectButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@android:color/transparent"
                        android:text="เชื่อมต่อ"
                        android:textColor="@color/text"
                        android:textSize="15sp" />
                </LinearLayout>
            </FrameLayout>

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="ยังไม่เชื่อม"
                android:textColor="@color/muted"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/proxyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="proxy.internal.example:8080 · HTTP"
                android:textColor="@color/muted"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/hostInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Proxy host"
                    android:text="proxy.internal.example"
                    android:textColor="@color/text"
                    android:textColorHint="@color/muted"
                    android:singleLine="true" />

                <EditText
                    android:id="@+id/portInput"
                    android:layout_width="75dp"
                    android:layout_height="wrap_content"
                    android:hint="Port"
                    android:text="8080"
                    android:inputType="number"
                    android:textColor="@color/text"
                    android:textColorHint="@color/muted"
                    android:singleLine="true" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:weightSum="3">

                <TextView
                    android:id="@+id/uploadText"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:background="@drawable/card"
                    android:text="อัปโหลด\n0 B"
                    android:textColor="@color/text"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/downloadText"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:gravity="center"
                    android:background="@drawable/card"
                    android:text="ดาวน์โหลด\n0 B"
                    android:textColor="@color/text"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/sessionText"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:gravity="center"
                    android:background="@drawable/card"
                    android:text="เซสชัน\n00:00:00"
                    android:textColor="@color/text"
                    android:textSize="13sp" />
            </LinearLayout>

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="หน้าแรก     พร็อกซี     เพย์โหลด     แอป     บันทึก     เกี่ยวกับ"
                android:textColor="@color/muted"
                android:textSize="11sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
