<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- หน้าหลักของแอป -->
    <RelativeLayout
        android:id="@+id/mainRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@id/bottomDivider"
            android:orientation="vertical">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@color/toolbar_bg"
                app:navigationIcon="@drawable/ic_hamburger"
                app:navigationIconTint="@color/text">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing=".18"
                    android:text="@string/app_name"
                    android:textColor="@color/text"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </com.google.android.material.appbar.MaterialToolbar>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp">

                    <!-- ปุ่ม Power วงกลมหลัก -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="220dp"
                        android:layout_marginTop="16dp">

                        <View
                            android:layout_width="190dp"
                            android:layout_height="190dp"
                            android:layout_gravity="center"
                            android:background="@drawable/ring_outer" />

                        <View
                            android:layout_width="150dp"
                            android:layout_height="150dp"
                            android:layout_gravity="center"
                            android:background="@drawable/ring_inner" />

                        <!-- ปุ่มกดวงกลมด้านใน -->
                        <LinearLayout
                            android:id="@+id/btnConnect"
                            android:layout_width="120dp"
                            android:layout_height="120dp"
                            android:layout_gravity="center"
                            android:background="@drawable/power_circle"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="vertical">

                            <!-- ไอคอน Power แบบรูปที่ 2 -->
                            <ImageView
                                android:id="@+id/powerIcon"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:src="@drawable/ic_power"
                                app:tint="@color/text" />

                            <TextView
                                android:id="@+id/connectText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="เชื่อมต่อ"
                                android:textColor="@color/text"
                                android:textSize="14sp" />
                        </LinearLayout>
                    </FrameLayout>

                    <TextView
                        android:id="@+id/statusText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:text="ยังไม่เชื่อม"
                        android:textColor="@color/muted"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/proxyText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:text="proxy.internal.example:8080 · HTTP"
                        android:textColor="@color/muted"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/hostInput"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="Proxy host"
                            android:singleLine="true"
                            android:text="proxy.internal.example"
                            android:textColor="@color/text"
                            android:textColorHint="@color/muted" />

                        <EditText
                            android:id="@+id/portInput"
                            android:layout_width="75dp"
                            android:layout_height="wrap_content"
                            android:hint="Port"
                            android:inputType="number"
                            android:singleLine="true"
                            android:text="8080"
                            android:textColor="@color/text"
                            android:textColorHint="@color/muted" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal"
                        android:weightSum="3">

                        <TextView
                            android:id="@+id/uploadText"
                            android:layout_width="0dp"
                            android:layout_height="60dp"
                            android:layout_weight="1"
                            android:background="@drawable/card"
                            android:gravity="center"
                            android:text="อัปโหลด\n0 B"
                            android:textColor="@color/text"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/downloadText"
                            android:layout_width="0dp"
                            android:layout_height="60dp"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:background="@drawable/card"
                            android:gravity="center"
                            android:text="ดาวน์โหลด\n0 B"
                            android:textColor="@color/text"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/sessionText"
                            android:layout_width="0dp"
                            android:layout_height="60dp"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:background="@drawable/card"
                            android:gravity="center"
                            android:text="เซสชัน\n00:00:00"
                            android:textColor="@color/text"
                            android:textSize="13sp" />
                    </LinearLayout>

                </LinearLayout>
            </ScrollView>
        </LinearLayout>

        <!-- เส้นแบ่งสีบางๆ (Divider Line) -->
        <View
            android:id="@+id/bottomDivider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_above="@id/bottomNavigation"
            android:background="#1E293B" />

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNavigation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:background="@color/bg"
            app:itemIconTint="@color/text"
            app:itemTextColor="@color/text"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/bottom_nav_menu" />

    </RelativeLayout>

    <!-- เมนูสไลด์ด้านข้าง (Navigation Drawer) -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigation_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/bg"
        app:itemIconTint="@color/text"
        app:itemTextColor="@color/text"
        app:menu="@menu/drawer_menu" />

</androidx.drawerlayout.widget.DrawerLayout>
